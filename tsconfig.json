{
  // Type checking only (npm run check): the app is plain JavaScript, built by Vite as before. Files
  // are checked when they start with `// @ts-check`; the contracts are in src/types.d.ts.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["src"]
}
